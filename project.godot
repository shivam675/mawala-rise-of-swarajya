; Godot 4.6.1 — MAVALA: Rise of Swarajya
config_version=5

[application]
config/name="MAVALA: Rise of Swarajya"
run/main_scene="res://core/main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/description="A fictional journey through the Sahyadri, circa 1646."

[display]
window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1920
window/size/window_height_override=1080
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/default_filters/anisotropic_filtering_level=2
anti_aliasing/quality/msaa_3d=1
environment/defaults/default_clear_color=Color(0.42, 0.38, 0.36, 1)
lights_and_shadows/directional_shadow/size=2048

[audio]
driver/enable_input=false

[physics]
common/physics_ticks_per_second=60
